#!/bin/bash

export DIALOGRC="${DIALOGRC:-/etc/mjolnir/dialogrc}"

PROFIL=$(dialog --clear \
  --backtitle "MjolnirOS - Installateur" \
  --title "Profil de la machine" \
  --menu "Choisis le profil a installer :" 15 60 3 \
  poste   "Poste de bureau avec univers graphique" \
  serveur "Serveur terminal militaire (CLI)" \
  minimal "Base seule" \
  3>&1 1>&2 2>&3)

RETOUR=$?

if [ $RETOUR -ne 0 ]; then
    clear
    echo "Installation annulée."
    exit 1
fi

LISTE_DISQUES=$(lsblk -dn -o NAME,SIZE,TYPE | awk '$3=="disk" && $1 !~ /^zram/ {print "/dev/"$1" - "$2}')
NB_DISQUES=$(echo "$LISTE_DISQUES" | grep -c .)

dialog --cr-wrap \
  --backtitle "MjolnirOS - Installateur" \
  --title "Disques détectés" \
  --msgbox "$NB_DISQUES disque(s) détecté(s) :\n\n$LISTE_DISQUES" 15 60

if [ $NB_DISQUES -eq 0 ]; then
    dialog --backtitle "MjolnirOS - Installateur" \
      --title "Erreur" \
      --msgbox "Aucun disque détecté. Installation impossible." 8 50
    clear
    exit 1
fi

OPTIONS=(ext4 "Standard, un seul disque")
OPTIONS+=(btrfs "Btrfs + snapper, un seul disque")

if [ $NB_DISQUES -ge 2 ]; then
    OPTIONS+=(raid0 "mdadm RAID 0 + Btrfs + snapper")
    OPTIONS+=(raid1 "mdadm RAID 1 + Btrfs + snapper")
fi

if [ $NB_DISQUES -ge 3 ]; then
    OPTIONS+=(raid5 "mdadm RAID 5 + Btrfs + snapper")
fi

if [ $NB_DISQUES -ge 4 ]; then
    OPTIONS+=(raid6 "mdadm RAID 6 + Btrfs + snapper")
    OPTIONS+=(raid10 "mdadm RAID 10 + Btrfs + snapper")
fi

STOCKAGE=$(dialog --clear \
  --backtitle "MjolnirOS - Installateur" \
  --title "Stockage" \
  --menu "Choisis la configuration des disques :" 15 60 6 \
  "${OPTIONS[@]}" \
  3>&1 1>&2 2>&3)

clear

echo "Profil : $PROFIL"
echo "Stockage : $STOCKAGE"
